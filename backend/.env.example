# Copy this file to .env (Windows: copy .env.example .env) and fill in real values.
# NEVER commit the real .env file.

# PostgreSQL connection (create a database named "internlink" first)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/internlink?schema=public"

# JWT
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000

# Allowed frontend origins (comma separated) - VS Code Live Server
CLIENT_URL="http://localhost:5500,http://127.0.0.1:5500"

# First admin created by: npx prisma db seed
ADMIN_NAME="InternLink Admin"
ADMIN_EMAIL="admin@internlink.local"
ADMIN_PASSWORD="choose_a_strong_admin_password"

# OPTIONAL development/test data (NOT for production).
# Set SEED_SAMPLE_DATA=true and give a password to create sample faculty/company/student accounts.
SEED_SAMPLE_DATA=false
SAMPLE_DATA_PASSWORD=""
